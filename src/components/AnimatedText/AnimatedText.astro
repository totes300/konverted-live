---
import { cx } from "~/features/style/utils";

// Line-split intro animation built on GSAP SplitText (line masks). The element reveals once
// fonts are loaded, the page transition has finished, and the host has entered the viewport.
type Props = {
  /** Use `div` when wrapping block-level content (e.g. full rich text) so the split spans all lines in order. */
  as?: "span" | "div";
  class?: string;
  staggerDelay?: number;
  duration?: number;
  animationDelay?: number;
  /** Optional selector for text-only split targets inside the host. */
  splitSelector?: string;
  /** `false` skips viewport gating (plays as soon as fonts/transition allow); `margin` overrides the observer rootMargin. */
  viewport?: false | { margin?: string };
  /** Where the lines start behind their mask: `below` rises into place, `above` drops down out from under whatever sits on top of it. */
  from?: "below" | "above";
};

const { as = "span", class: className, staggerDelay, duration, animationDelay, splitSelector, viewport, from } = Astro.props;
---

{/* Imperceptible but > 0 so the SSR text still paints and counts as the LCP candidate. */}
<animated-text
  class={cx(as === "div" && "block w-full", className)}
  style="opacity: 0.001"
  data-span={as === "span" ? "" : undefined}
  data-stagger={staggerDelay}
  data-duration={duration}
  data-delay={animationDelay}
  data-split-selector={splitSelector}
  data-viewport-disabled={viewport === false ? "" : undefined}
  data-viewport-margin={viewport === false ? undefined : viewport?.margin}
  data-from={from === "above" ? "above" : undefined}
>
  <slot />
</animated-text>

<script>
  import './AnimatedTextElement'
</script>
