---
import Icon from "~/components/Icon/Icon.astro";
import type { SiteFooterQResult } from "~/sanity/types";
import { getDraftModeProps } from "../../../sanity/lib/draft-mode";
import { loadQuery } from "../../../sanity/lib/load-query";
import { SiteFooterQ } from "./query";

const { data: siteFooter } = await loadQuery<SiteFooterQResult>({ query: SiteFooterQ, ...getDraftModeProps(Astro) });

const tagline = siteFooter?.footer?.tagline;
const year = new Date().getFullYear();
---

{/* The tagline leads on a phone and the copyright follows it; `lg:flex-row-reverse` puts the
    copyright back on the left of the row without reordering the markup. */}
<footer>
  <div
    class="mx-auto flex max-w-(--page-width) flex-col gap-16 px-(--page-gutter) py-48 lg:flex-row-reverse lg:items-center lg:justify-between"
  >
    {
      tagline && (
        <p class="flex items-center gap-10 font-display text-title text-ink">
          {/* Sized in `em` so the mark rides the line as a glyph rather than sitting beside it as a logo;
              square, because a width left to resolve from the child's `size-full` is circular and
              WebKit answers it with a box wide enough to push the tagline into a column. */}
          <Icon name="webos-pixel" class="size-[0.72em] shrink-0 text-accent" />
          {tagline}
        </p>
      )
    }
    <p class="text-body-10 text-ink-soft">© {year} {siteFooter?.name}</p>
  </div>
</footer>
