---
import { stegaClean } from "@sanity/client/stega";
import InnerParallax from "~/components/InnerParallax/InnerParallax.astro";
import { MediaSectionQ } from "~/features/page-builder/queries";
import SectionFrame from "~/features/page-builder/SectionFrame.astro";
import type { SectionProps } from "~/features/page-builder/types";
import type { MediaSectionQResult } from "~/sanity/types";
import { getDraftModeProps } from "../../../sanity/lib/draft-mode";
import { loadQuery } from "../../../sanity/lib/load-query";
import SanityMedia from "../../../sanity/media/SanityMedia.astro";

type Props = SectionProps;

const { docId, sectionKey, isFirst = false } = Astro.props;

const { data: section } = await loadQuery<MediaSectionQResult>({
  query: MediaSectionQ,
  params: { docId, sectionKey },
  ...getDraftModeProps(Astro),
});

const { media, caption, useParallax } = section?.content ?? {};

// The first section is the LCP candidate, but only images want the hint: on a video it would flip preload to auto and pull the whole file.
const priority = isFirst && media?.type === "image";
---

{
  section?.content && (
    <SectionFrame
      as="figure"
      settings={section.settings}
      id={stegaClean(section.settings?.hash) ?? undefined}
      data-page-builder-section="mediaSection"
    >
      {useParallax ? (
        <InnerParallax overflow="60 lg:120" style={{ aspectRatio: media?.aspectRatio ?? undefined }}>
          <SanityMedia media={media} priority={priority} class="size-full object-cover" />
        </InnerParallax>
      ) : (
        <SanityMedia media={media} priority={priority} class="w-full" />
      )}
      {caption && <figcaption class="mt-12 font-pixel-square text-caption whitespace-pre-line text-white/50">{caption}</figcaption>}
    </SectionFrame>
  )
}
