---
import { cx } from "~/features/style/utils";

// The brand's pixel-dissolve: one grid of accent cells whose opacity ramps along a direction with
// a little per-cell scatter, so an image dissolves into pixels. Cells share the grid, so edges
// always join; the PRNG is seeded, so the server renders the same mosaic every time.
type Props = {
  cols: number;
  rows: number;
  /** Where the mosaic is solid: `right` ramps left-to-right, `up` ramps top-to-bottom. */
  direction?: "right" | "up";
  seed?: number;
  class?: string;
};

const { cols, rows, direction = "right", seed = 1, class: className } = Astro.props;

function mulberry32(initialSeed: number) {
  let state = initialSeed | 0;

  return () => {
    state = (state + 0x6d2b79f5) | 0;
    let t = Math.imul(state ^ (state >>> 15), 1 | state);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}

const rand = mulberry32(seed);

const cells: number[] = [];

for (let row = 0; row < rows; row++) {
  for (let col = 0; col < cols; col++) {
    const progress = direction === "right" ? (col + 0.5) / cols : (row + 0.5) / rows;
    const jitter = 0.7 + 0.6 * rand();
    const opacity = Math.min(1, progress ** 1.7 * jitter);
    cells.push(opacity < 0.07 ? 0 : Math.round(opacity * 100) / 100);
  }
}
---

<div
  aria-hidden="true"
  class={cx("pointer-events-none grid", className)}
  style={`grid-template-columns: repeat(${cols}, 1fr); grid-template-rows: repeat(${rows}, 1fr);`}
>
  {cells.map((opacity) => <div class="bg-accent" style={`opacity: ${opacity}`} />)}
</div>
