---
import { stegaClean } from "@sanity/client/stega";
import CalEmbed from "~/components/CalEmbed/CalEmbed.astro";
import Icon from "~/components/Icon/Icon.astro";
import { LeadFormSectionQ } from "~/features/page-builder/queries";
import SectionFrame from "~/features/page-builder/SectionFrame.astro";
import SectionHeader from "~/features/page-builder/SectionHeader.astro";
import type { SectionProps } from "~/features/page-builder/types";
import type { LeadFormSectionQResult } from "~/sanity/types";
import { getDraftModeProps } from "../../../../sanity/lib/draft-mode";
import { loadQuery } from "../../../../sanity/lib/load-query";
import SanityMedia from "../../../../sanity/media/SanityMedia.astro";

type Props = SectionProps;

const { docId, sectionKey } = Astro.props;

const { data: section } = await loadQuery<LeadFormSectionQResult>({
  query: LeadFormSectionQ,
  params: { docId, sectionKey },
  ...getDraftModeProps(Astro),
});

const contact = section?.content?.contact;
const points = section?.content?.points ?? [];

// Cleaned: both reach the booker as a URL, and a stega character in one is a 404 rather than a booking.
const calLink = stegaClean(section?.content?.calLink) ?? "";
const calNamespace = stegaClean(section?.content?.calNamespace) ?? "default";

// A byline portrait is a still even when it is a video: it sits at thumbnail size beside a name.
const PORTRAIT_VIDEO = { autoPlay: true, loop: true, muted: true, noControls: true };

const CONTACT_LINK = "text-caption text-ink underline underline-offset-4 hover:text-accent";
---

{
  section?.content && (
    <SectionFrame
      settings={section.settings}
      id={stegaClean(section.settings?.hash) ?? undefined}
      data-page-builder-section="leadFormSection"
    >
      <SectionHeader eyebrow={section.content.eyebrow} class="lg:grid lg:grid-cols-12 lg:gap-x-48">
        <div class="flex flex-col lg:col-span-6">
          {/* `headline-15`, not `headline-20`: this title shares its row with the booker, on half a column. */}
          <h2 class="font-display text-headline-15 whitespace-pre-line text-accent">{section.content.headline}</h2>

          {section.content.lede && <p class="mt-32 max-w-[52ch] text-body-20 text-ink-soft">{section.content.lede}</p>}

          {points.length > 0 && (
            <ul class="mt-32 flex list-none flex-col">
              {points.map((point) => (
                <li class="flex items-start gap-16 border-t border-line py-16 last:border-b">
                  <Icon name="check" class="mt-2 size-16 shrink-0 text-accent" />
                  <span class="text-body-10 text-ink-soft">{point}</span>
                </li>
              ))}
            </ul>
          )}

          {contact?.name && (
            <div class="mt-32 flex items-center gap-16">
              {contact.portrait?.type && (
                <span class="flex h-96 w-72 shrink-0 overflow-hidden rounded-4">
                  <SanityMedia
                    media={contact.portrait}
                    class="size-full object-cover"
                    imageProps={{ sizes: "72px" }}
                    videoProps={PORTRAIT_VIDEO}
                  />
                </span>
              )}

              <div class="flex flex-col gap-4">
                <p class="text-cta text-ink">{contact.name}</p>
                {contact.role && <p class="text-caption text-ink-soft/60">{contact.role}</p>}

                <div class="mt-4 flex flex-wrap gap-x-16 gap-y-4">
                  {contact.email && (
                    <a href={`mailto:${stegaClean(contact.email)}`} class={CONTACT_LINK}>
                      {contact.email}
                    </a>
                  )}
                  {contact.phone && (
                    <a href={`tel:${stegaClean(contact.phone).replace(/\s/g, "")}`} class={CONTACT_LINK}>
                      {contact.phone}
                    </a>
                  )}
                </div>
              </div>
            </div>
          )}
        </div>

        {/* The card is the column, so the grid row makes it exactly as tall as the copy beside it: the
            two lines around the booker live inside it rather than pushing it off that height. */}
        <div class="mt-(--section-block) flex lg:col-span-6 lg:col-start-7 lg:mt-0">
          <div class="flex w-full flex-col gap-16 rounded-16 bg-paper-warm p-16 lg:p-20">
            {section.content.bookingIntro && <p class="text-caption text-ink-soft/70">{section.content.bookingIntro}</p>}

            {calLink && <CalEmbed calLink={calLink} namespace={calNamespace} class="min-h-0 flex-1 overflow-hidden rounded-12" />}

            {section.content.reassurance && <p class="text-caption text-ink-soft/70">{section.content.reassurance}</p>}
          </div>
        </div>
      </SectionHeader>
    </SectionFrame>
  )
}
