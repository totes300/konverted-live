---
import { type SectionLayoutSettings, sectionLayout } from "~/features/page-builder/section-layout";
import { cx } from "~/features/style/utils";

// The root every page builder section renders. It caps the section to the content column on the
// page gutter, or runs it full bleed when the editor's section settings say so, and it names the
// section to a parser through `as`.
type Props = {
  /** A section is a `section`. One with no heading of its own is not part of the outline, so it stays generic. */
  as?: "section" | "div" | "article" | "aside" | "figure" | "nav";
  /** The section's own `sectionSettings` slice, straight from its query. */
  settings?: SectionLayoutSettings | null;
  id?: string;
  class?: string;
  /** Hooks the section needs on its outermost element, e.g. the page builder's marker. */
  [key: `data-${string}`]: string | undefined;
};

const { as: Tag = "section", settings, id, class: className, ...data } = Astro.props;
---

<Tag id={id} class={cx(sectionLayout(settings), className)} {...data}>
  <slot />
</Tag>
