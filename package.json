{
  "name": "the-content-architecture-astro",
  "version": "0.0.0",
  "private": true,
  "engines": {
    "node": "^24.15.0",
    "npm": ">=11.6.2"
  },
  "volta": {
    "node": "24.15.0"
  },
  "overrides": {
    "vite": "8.1.4",
    "@sanity/visual-editing": "^6.1.1"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "start": "vercel dev",
    "check": "concurrently npm:check.*",
    "precheck.types": "npm run sanity:typegen",
    "check.types": "astro check",
    "check.biome": "biome lint --diagnostic-level=error --no-errors-on-unmatched --files-ignore-unknown=true",
    "format": "biome check --write --unsafe",
    "test": "node --import=tsx --test \"scripts/**/*.test.ts\" \"src/**/*.test.ts\" \"sanity/**/*.test.ts\"",
    "plop": "plop",
    "clear": "rm -rf .astro node_modules/.vite node_modules/.vite-build dist .vercel/output",
    "dev:clean": "npm run clear && astro dev",
    "sanity:typegen": "dotenvx run -- sh -c \"sanity schema extract --force --path='sanity-schema.json' && sanity typegen generate && sed -i.bak 's/| null/| undefined/g; s/null |/undefined |/g; s/{} |//g; s/| {}//g' sanity/types.ts && rm sanity/types.ts.bak\"",
    "sanity:cli": "dotenvx run -- sanity",
    "sanity:schema-deploy": "dotenvx run -- sanity schema deploy",
    "sanity:dataset-export": "dotenvx run -- node --import=tsx scripts/sanity-dataset/export.ts",
    "sanity:dataset-import": "dotenvx run -- node --import=tsx scripts/sanity-dataset/import.ts",
    "sanity:dataset-migrate": "dotenvx run -- node --import=tsx scripts/sanity-dataset/migrate.ts",
    "sanity:project-setup": "dotenvx run --ignore=MISSING_ENV_FILE -- node --import=tsx scripts/sanity-project-setup/setup.ts"
  },
  "dependencies": {
    "@astrojs/react": "6.0.4",
    "@astrojs/vercel": "11.0.8",
    "@calcom/embed-snippet": "^1.3.3",
    "@dotenvx/dotenvx": "2.22.0",
    "@fontsource-variable/caveat": "^5.3.0",
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@fontsource-variable/instrument-sans": "5.3.0",
    "@lottiefiles/dotlottie-wc": "0.9.28",
    "@mux/mux-player": "3.13.2",
    "@rive-app/canvas": "2.41.0",
    "@rive-app/canvas-advanced-single": "2.41.0",
    "@sanity/astro": "3.5.1",
    "@sanity/client": "8.4.0",
    "@sanity/icons": "5.2.1",
    "@sanity/image-url": "2.1.1",
    "@sanity/preview-url-secret": "4.1.5",
    "@sanity/vision": "6.11.0",
    "@sanity/webhook": "4.0.4",
    "@vercel/functions": "3.9.5",
    "astro": "7.2.9",
    "astro-portabletext": "1.0.0",
    "change-case": "5.4.4",
    "gsap": "3.15.0",
    "lenis": "1.3.26",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-is": "19.2.8",
    "resend": "6.25.0",
    "sanity": "6.11.0",
    "sanity-plugin-media": "6.1.7",
    "sanity-plugin-mux-input": "5.0.12",
    "sharp": "0.35.4",
    "styled-components": "6.5.3",
    "tailwind-merge": "3.6.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@biomejs/biome": "2.5.11",
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.4.0",
    "@types/prompts": "2.4.9",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "commander": "15.0.0",
    "concurrently": "10.0.5",
    "lefthook": "2.1.12",
    "ora": "9.4.1",
    "plop": "4.0.5",
    "prompts": "2.4.2",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.13",
    "typescript": "6.0.3"
  }
}
